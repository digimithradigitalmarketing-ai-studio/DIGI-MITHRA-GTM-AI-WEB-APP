# Names only. Copy to .env.local and fill in values. Never commit .env.local.

# Supabase: the publishable key is safe in the browser.
# SUPABASE_SERVICE_ROLE_KEY is server-only and never gets a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Phase 6: optional AI provider key. Server-side only, never NEXT_PUBLIC_.
GEMINI_API_KEY=
