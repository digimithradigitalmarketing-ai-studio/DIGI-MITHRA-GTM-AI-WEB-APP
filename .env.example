# Names only. Copy to .env.local and fill in values later. Never commit .env.local.
# Phase 1 (this build) needs no environment variables.

# Phase 2: Supabase (publishable key is safe in the browser; service role is server-only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Phase 6: optional AI provider key. Server-side only, never NEXT_PUBLIC_.
GEMINI_API_KEY=
